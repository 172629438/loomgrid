<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V4SimPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scott="using:ScottPlot.WinUI"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,18,28,12" Spacing="3">
            <TextBlock Style="{StaticResource TextDisplay}" Text="负荷模拟" />
            <TextBlock Style="{StaticResource TextCaption}"
                       Text="选行业模板、调参数、看实时预览。应用后 V4 测算与 V3 预览都改用这条曲线，原始数据不动。" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="28,0,28,10" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Margin="0,0,8,0">

                    <TextBlock Style="{StaticResource TextCaption}" Text="行业模板（25 个）" />
                    <ComboBox x:Name="IndustryCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="OnIndustryChanged" />
                    <TextBlock x:Name="TemplateSourceText" Style="{StaticResource TextCaption}"
                               Text="" TextWrapping="Wrap" />

                    <Rectangle Height="1" HorizontalAlignment="Stretch"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="平均功率" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="AvgPowerBox" Text="500"
                                 FontFamily="{StaticResource MonoFamily}" TextChanged="OnParamChanged" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}"
                                   Text="kW" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 三个系数的展示模式：左边滑杆、右边当前值，最右一列常驻模板原值。
                         模板值与当前值必须并列 —— 只有当前值时用户不知道改没改过，只有模板值时
                         用户不知道现在生效的是什么。 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="日负荷率" VerticalAlignment="Center" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="LfSlider" Minimum="0.1" Maximum="1.0"
                                StepFrequency="0.01" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LfValue" Style="{StaticResource TextCaption}"
                                   FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="LfTemplate" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Opacity="0.55" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="峰谷差率" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="PvSlider" Minimum="0.05" Maximum="0.95"
                                StepFrequency="0.01" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PvValue" Style="{StaticResource TextCaption}"
                                   FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="PvTemplate" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Opacity="0.55" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="周末系数" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="WfSlider" Minimum="0.1" Maximum="1.0"
                                StepFrequency="0.01" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="WfValue" Style="{StaticResource TextCaption}"
                                   FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="WfTemplate" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Opacity="0.55" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="噪声" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="NoiseSlider" Minimum="0" Maximum="0.3"
                                Value="0.05" StepFrequency="0.01" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Column="2" x:Name="NoiseValue" Style="{StaticResource TextCaption}"
                                   FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}"
                                   Text="越大越抖" VerticalAlignment="Center" Opacity="0.55" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="光伏容量" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="PvKwSlider" Minimum="0" Maximum="5000"
                                StepFrequency="10" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Column="2" x:Name="PvKwValue" Style="{StaticResource TextCaption}"
                                   FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}"
                                   Text="kW 可叠" VerticalAlignment="Center" Opacity="0.55" />
                    </Grid>

                    <Rectangle Height="1" HorizontalAlignment="Stretch"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextCaption}"
                                   Text="天数" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="DaysBox" Text="31"
                                 FontFamily="{StaticResource MonoFamily}" TextChanged="OnParamChanged" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}"
                                   Text="点数" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3" x:Name="PointsCombo" SelectedIndex="0"
                                  SelectionChanged="OnPointsChanged" />
                    </Grid>

                    <TextBlock x:Name="HintText" Style="{StaticResource TextCaption}"
                               Text="" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <scott:WinUIPlot x:Name="PreviewPlot" />
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatsText" Grid.Column="0" Style="{StaticResource TextCaption}"
                               FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center" Text="" />
                    <TextBlock x:Name="SeedText" Grid.Column="1" Style="{StaticResource TextCaption}"
                               FontFamily="{StaticResource MonoFamily}" VerticalAlignment="Center"
                               Opacity="0.75" Text="" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="28,0,28,16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="返回容量测算" Click="OnCancelClick" />
            <Button Grid.Column="2" Content="换一条" Click="OnReshuffleClick"
                    ToolTipService.ToolTip="换一个随机种子，同样的参数得到另一条噪声实例。预览与应用始终共用同一个种子。" />
            <Button Grid.Column="3" x:Name="ApplyButton" Content="应用这个配置"
                    Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick" IsEnabled="False" />
        </Grid>
    </Grid>
</Page>
