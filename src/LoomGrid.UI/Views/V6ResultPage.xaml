<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V6ResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,18,28,14" Spacing="3">
            <TextBlock Style="{StaticResource TextDisplay}" Text="结果" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource TextCaption}" Text="—" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 左：图表缩略图 -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="ChartLabel"
                    Grid.Row="0"
                    Style="{StaticResource TextCaption}"
                    Text="图表" />

                <GridView
                    x:Name="ChartGrid"
                    Grid.Row="1"
                    Padding="0"
                    SelectionMode="None">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:ExportArtifact">
                            <StackPanel Width="236" Spacing="4">
                                <Image
                                    Height="132"
                                    HorizontalAlignment="Stretch"
                                    ImageFailed="OnThumbFailed"
                                    Source="{x:Bind Thumb, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                                <TextBlock
                                    FontSize="{StaticResource FsCaption}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- 右：宽表 + 失败归因 -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="MidwideLabel"
                    Grid.Row="0"
                    Style="{StaticResource TextCaption}"
                    Text="中间宽表" />
                <ListView
                    x:Name="MidwideList"
                    Grid.Row="1"
                    MaxHeight="220"
                    Padding="0"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,5" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ExportArtifact">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="{StaticResource FsBody}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsCaption}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SizeText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="FailLabel"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Style="{StaticResource TextCaption}"
                    Text="失败" />
                <TextBlock
                    x:Name="FailHint"
                    Grid.Row="3"
                    Style="{StaticResource TextCaption}"
                    Text=""
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="FailList"
                    Grid.Row="4"
                    Padding="0"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FailureGroup">
                            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock
                                        FontSize="{StaticResource FsCaption}"
                                        Text="{x:Bind Header}"
                                        TextTrimming="CharacterEllipsis" />
                                </Expander.Header>
                                <TextBlock
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsCaption}"
                                    Text="{x:Bind Detail}"
                                    TextWrapping="Wrap" />
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="28,10,28,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="FooterText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MonoFamily}"
                FontSize="{StaticResource FsCaption}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text=""
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnOpenDirClick" Content="打开输出目录" />
                <Button
                    x:Name="RetryButton"
                    Click="OnRetryClick"
                    Content="仅重试失败项"
                    IsEnabled="False" />
                <Button Click="OnBackClick" Content="回到工作台" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
