<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V2MappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,18,28,14" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Style="{StaticResource TextDisplay}" Text="列映射" />
                <TextBlock x:Name="SubtitleText" FontSize="{StaticResource FsCaption}" Text="逐文件确认" />
            </StackPanel>
            <TextBlock x:Name="ProgressText" Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FsCaption}" Text="0 / 0" />
        </Grid>

        <StackPanel Grid.Row="0" Padding="28,0,28,14" Spacing="6" />

        <Grid Grid.Row="1" Padding="28,0,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListView
                    x:Name="FileList"
                    Grid.Row="0"
                    Padding="0"
                    SelectionChanged="OnFileSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:WorkFile">
                            <TextBlock FontSize="{StaticResource FsBody}" Text="{x:Bind FileName}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    x:Name="SheetList"
                    Grid.Row="1"
                    Padding="0"
                    SelectionChanged="OnSheetSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="18" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock FontSize="{StaticResource FsCaption}" Text="日期列" />
                        <ComboBox x:Name="DateCombo" MinWidth="180" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontSize="{StaticResource FsCaption}" Text="资产列（可选）" />
                        <ComboBox x:Name="AssetCombo" MinWidth="160" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="{StaticResource FsCaption}" Text="负荷列" />
                        <TextBlock x:Name="LoadInfoText" FontSize="{StaticResource FsBody}" Text="—" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PreviewCaption" Grid.Row="0" Margin="14,10,14,8" FontSize="{StaticResource FsCaption}" Text="选一个工作表" />
                        <ScrollViewer Grid.Row="1" Padding="14,0,14,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="PreviewGrid" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="28,10,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="{StaticResource FsCaption}" Text="" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnBackClick" AccessKey="B" Content="返回工作台" />
                <Button x:Name="ConfirmButton" AccessKey="C" Click="OnConfirmClick" Content="确认这个文件" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="NextButton" AccessKey="N" Click="OnNextClick" Content="下一步：预览曲线" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
