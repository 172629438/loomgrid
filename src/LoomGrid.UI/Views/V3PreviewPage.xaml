<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V3PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scott="using:ScottPlot.WinUI"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,18,28,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Style="{StaticResource TextDisplay}" Text="预览与策略" />
                <TextBlock
                    x:Name="SubtitleText"
                    Style="{StaticResource TextCaption}"
                    Text="选分组看曲线；换组用底部按钮或键盘 ← →" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
                <TextBlock x:Name="CounterText" HorizontalTextAlignment="Right"
                           FontFamily="{StaticResource MonoFamily}"
                           FontSize="{StaticResource FsCaption}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="—" />
                <TextBlock x:Name="ShapeText" HorizontalTextAlignment="Right"
                           FontFamily="{StaticResource MonoFamily}"
                           FontSize="{StaticResource FsCaption}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource TextCaption}" Text="分组（资产 · 月份 · 点数）" />
                <ListView
                    x:Name="GroupList"
                    Grid.Row="1"
                    Padding="0"
                    SelectionChanged="OnGroupSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,5" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- 日期面板：点一天就只看那天，再点一次取消回到全部。 -->
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource TextCaption}" Text="日期（点一天只看那天）" />
                    <Grid x:Name="DateGrid" />
                </StackPanel>

                <!-- 暂不可用：按原位置放 + 禁用 + tooltip。位置是功能的一部分，
                     集中搬到另一个面板会让按记忆找功能的用户找不到。 -->
                <StackPanel Grid.Row="3" Spacing="5" Margin="0,10,0,0">
                    <Rectangle Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="暂不可用（原 Fusion 有，未实现）" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Content="时段编辑"
                            IsEnabled="False"
                            Opacity="0.5"
                            ToolTipService.ToolTip="未实现。原 Fusion 可按分组/月份编辑充放时段，并从配置里按省份取默认时段。" />
                        <Button
                            Content="配色"
                            IsEnabled="False"
                            Opacity="0.5"
                            ToolTipService.ToolTip="未实现。原 Fusion 可自定义工作日/周末/节假日的曲线颜色与线宽。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Content="模板"
                            IsEnabled="False"
                            Opacity="0.5"
                            ToolTipService.ToolTip="未实现。原 Fusion 支持保存/加载/导入/导出图表样式模板。" />
                        <Button
                            Content="策略管理"
                            IsEnabled="False"
                            Opacity="0.5"
                            ToolTipService.ToolTip="未实现。原 Fusion 可管理出图策略预设。" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 图 + 探针浮层。
                 探针用 XAML 浮层而不是 plot.Add.Text：后者每次鼠标移动都重绘整个 Plot
                 （96 点 × N 天的曲线，每秒几十次），必然卡。浮层只改 Canvas 位置，
                 ScottPlot 一次不重绘。IsHitTestVisible=False 让浮层不吃鼠标事件。 -->
            <!-- Background="Transparent" 不能省：WinUI 里 Background 为 null 的 Panel **不参与命中测试**，
                 指针事件根本不会触达。之前两次 PointerMoved 不生效（日志 0 行）就是这个原因。
                 注意 Transparent 不是 null：Transparent 能命中，null 不能。 -->
            <Grid Grid.Column="1" Background="Transparent" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited">
                <scott:WinUIPlot x:Name="PlotView" />
                <Border
                    x:Name="Probe"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel Spacing="1">
                        <TextBlock
                            x:Name="ProbeTime"
                            FontSize="{StaticResource FsCaption}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="" />
                        <TextBlock
                            x:Name="ProbeValue"
                            FontFamily="{StaticResource MonoFamily}"
                            FontSize="13"
                            Text="" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="28,8,28,12" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MissingText"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,6"
                Style="{StaticResource TextCaption}"
                Text="本版本暂未实现：时段编辑 · 省份策略 · 模板管理 · 配色自定义 · 策略管理 · 曲线探针与双点对比"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MonoFamily}"
                FontSize="{StaticResource FsCaption}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnBackClick" Content="返回映射" />
                <Button x:Name="PrevButton" Click="OnPrevClick" Content="上一组" IsEnabled="False" />
                <Button x:Name="NextButton" Click="OnNextClick" Content="下一组" IsEnabled="False" />
                <Button Click="OnGotoExportClick" Content="下一步：导出" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 完成度汇总已移到下方状态栏上方 -->
    </Grid>
</Page>
