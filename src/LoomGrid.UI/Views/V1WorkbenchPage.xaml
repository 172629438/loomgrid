<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V1WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 工具栏 ───────────────────────────────────── -->
        <Grid
            Grid.Row="0"
            Padding="28,18,28,14"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Style="{StaticResource TextDisplay}" Text="工作台" />
                <TextBlock
                    x:Name="SubtitleText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource TextCaption}"
                    Text="拖入 Excel 或 CSV，或点「添加文件」" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button x:Name="AddButton" AccessKey="A" Click="OnAddClick" Content="添加文件"
                        ToolTipService.ToolTip="快捷键 Alt+A" />
                <Button x:Name="RemoveButton" AccessKey="D" Click="OnRemoveClick" Content="移除选中" IsEnabled="False" />
                <Button x:Name="ClearButton" AccessKey="L" Click="OnClearClick" Content="清空" IsEnabled="False" />
                <Button
                    x:Name="NextButton"
                    AccessKey="N"
                    Click="OnNextClick"
                    Content="下一步：识别列"
                    IsEnabled="False"
                    ToolTipService.ToolTip="快捷键 Alt+N"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- ── 主体 ─────────────────────────────────────── -->
        <Grid Grid.Row="1" Padding="28,0,28,12">

            <!-- 空状态：整块拖放区 -->
            <Border
                x:Name="DropZone"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontSize="34"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8E5;" />
                    <TextBlock
                        x:Name="DropHintText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="把文件拖到这里" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource TextCaption}"
                        Text="支持 .xlsx / .xlsm / .csv，可一次拖入多个" />
                </StackPanel>
            </Border>

            <!-- 有文件时的表格 -->
            <Grid x:Name="ListArea" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头（点列名排序） -->
                <Grid
                    Grid.Row="0"
                    Padding="12,0,12,0"
                    ColumnSpacing="0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="136" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="OnSortFileName" Style="{StaticResource TableHeaderButtonStyle}" Content="源文件" />
                    <Button
                        Grid.Column="1"
                        Click="OnSortAsset"
                        Content="分组"
                        Style="{StaticResource TableHeaderButtonStyle}"
                        ToolTipService.ToolTip="完成列映射后才有值" />
                    <Button
                        Grid.Column="2"
                        Click="OnSortTimePoints"
                        Content="时刻点"
                        HorizontalContentAlignment="Right"
                        Style="{StaticResource TableHeaderButtonStyle}"
                        ToolTipService.ToolTip="完成列映射后才有值" />
                    <Button
                        Grid.Column="3"
                        Click="OnSortMin"
                        Content="最小负荷"
                        HorizontalContentAlignment="Right"
                        Style="{StaticResource TableHeaderButtonStyle}"
                        ToolTipService.ToolTip="完成列映射后才有值" />
                    <Button
                        Grid.Column="4"
                        Click="OnSortMax"
                        Content="最大负荷"
                        HorizontalContentAlignment="Right"
                        Style="{StaticResource TableHeaderButtonStyle}"
                        ToolTipService.ToolTip="完成列映射后才有值" />
                    <Button Grid.Column="5" Click="OnSortState" Style="{StaticResource TableHeaderButtonStyle}" Content="状态" />
                </Grid>

                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    Padding="0"
                    DoubleTapped="OnRowDoubleTapped"
                    SelectionChanged="OnSelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:WorkFile">
                            <Grid Padding="12,9,12,9" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="136" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock
                                        FontSize="{StaticResource FsBody}"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFamily}"
                                        FontSize="{StaticResource FsCaption}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SizeText}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FsBody}"
                                    Text="{x:Bind Asset}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsBody}"
                                    Text="{x:Bind TimePoints}" />

                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsBody}"
                                    Text="{x:Bind MinLoad}" />

                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsBody}"
                                    Text="{x:Bind MaxLoad}" />

                                <StackPanel
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Fill="{x:Bind StatusBrush}" />
                                    <TextBlock FontSize="{StaticResource FsBody}" Text="{x:Bind StatusText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ── 状态栏 ───────────────────────────────────── -->
        <Grid
            Grid.Row="2"
            Padding="28,10,28,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusLeftText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="{StaticResource FsCaption}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="文件 0 · 就绪 0 · 需确认 0 · 失败 0" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="14"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="NoticeText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="{StaticResource FsCaption}"
                    Text="" />
                <TextBlock
                    x:Name="BackendText"
                    FontFamily="{StaticResource MonoFamily}"
                    FontSize="{StaticResource FsCaption}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="后端：启动中…" />
                <!-- 关于：自述版本与未实现项。用户拿到程序第一个问题是
                     「和以前那个有什么区别」，让程序自己回答。 -->
                <Button
                    Padding="8,2"
                    Click="OnAboutClick"
                    AccessKey="B"
                    Content="关于"
                    FontSize="{StaticResource FsCaption}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
