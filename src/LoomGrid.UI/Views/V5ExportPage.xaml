<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V5ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,18,28,14" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Style="{StaticResource TextDisplay}" Text="导出" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource TextCaption}" Text="选要导出的分组" />
            </StackPanel>
            <TextBlock
                x:Name="CountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MonoFamily}"
                FontSize="{StaticResource FsCaption}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="0 / 0" />
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：清单 -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnSelectAll" Content="全选" />
                    <Button Click="OnSelectNone" Content="全不选" />
                    <Button Click="OnInvert" Content="反选" />
                </StackPanel>

                <Grid Grid.Row="1" Padding="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}" Text="文件 · 资产" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" Text="月份" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}" Text="点数" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TextCaption}" Text="倍率" />
                </Grid>

                <ListView
                    x:Name="ItemList"
                    Grid.Row="2"
                    Padding="0"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3,4,3" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ExportItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Checked="OnItemCheckedChanged"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    Unchecked="OnItemCheckedChanged" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="{StaticResource FsBody}"
                                        Text="{x:Bind Asset}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="{StaticResource FsCaption}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SourceFile}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsCaption}"
                                    Text="{x:Bind Month}" />

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsCaption}"
                                    Text="{x:Bind TimePointsText}" />

                                <TextBox
                                    Grid.Column="4"
                                    Margin="4,0,0,0"
                                    FontFamily="{StaticResource MonoFamily}"
                                    FontSize="{StaticResource FsCaption}"
                                    PlaceholderText="全局"
                                    Text="{x:Bind MultiplierText, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 右：配置（不用 Border 卡片，用两列 Grid + 分隔线；外层可滚动） -->
            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Margin="0,0,8,0">

                    <TextBlock Style="{StaticResource TextCaption}" Text="输出目录" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="OutputDirText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFamily}"
                            FontSize="{StaticResource FsCaption}"
                            Text="（未选择）"
                            TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Click="OnPickOutputDir" Content="选择…" />
                        <Button Grid.Column="2" Click="OnOpenOutputDir" Content="打开" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Style="{StaticResource TextCaption}" Text="命名模板" />
                    <TextBox x:Name="TitleBox" Header="标题" />
                    <TextBox x:Name="FileBox" Header="文件名" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="OnRefreshPreview" Content="刷新预览" />
                        <TextBlock
                            x:Name="PreviewText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFamily}"
                            FontSize="{StaticResource FsCaption}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource TextCaption}"
                        Text="占位符：{table_no} {year_month} {asset} {sheet}；文件名清洗由后端完成"
                        TextWrapping="Wrap" />

                    <Rectangle
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Style="{StaticResource TextCaption}" Text="参数" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Style="{StaticResource TextCaption}" Text="全局倍率" />
                            <TextBox x:Name="GlobalMultiplierBox" FontFamily="{StaticResource MonoFamily}" Text="1.0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Style="{StaticResource TextCaption}" Text="高亮模式" />
                            <ComboBox x:Name="HighlightCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="DarkThemeCheck" Content="深色图表" IsChecked="True" />
                    <CheckBox x:Name="MidwideCheck" Content="同时导出中间宽表（xlsx）" />

                    <Rectangle
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        Style="{StaticResource TextCaption}"
                        Text="逐行倍率：在左侧每行填数字即覆盖全局值；留空用全局。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="28,10,28,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource TextCaption}" Text="" />
                <ProgressBar
                    x:Name="Progress"
                    Height="3"
                    Maximum="100"
                    Value="0"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnBackClick" AccessKey="B" Content="返回映射" />
                <Button Click="OnCapacityClick" AccessKey="C" Content="容量测算" />
                <Button
                    x:Name="RunButton"
                    AccessKey="X"
                    Click="OnRunClick"
                    Content="开始导出"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="ResultButton"
                    AccessKey="V"
                    Click="OnResultClick"
                    Content="查看结果"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
