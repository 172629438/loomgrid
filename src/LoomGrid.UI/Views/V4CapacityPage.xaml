<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.V4CapacityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,18,28,14" Spacing="3">
            <TextBlock Style="{StaticResource TextDisplay}" Text="容量测算" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource TextCaption}" Text="选分组、设时段与策略，实时算容量" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：参数 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Margin="0,0,8,0">

                    <TextBlock Style="{StaticResource TextCaption}" Text="分组" />
                    <ComboBox x:Name="GroupCombo" HorizontalAlignment="Stretch" SelectionChanged="OnParamChanged" />

                    <Rectangle Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Style="{StaticResource TextCaption}" Text="时段（小时，0–24）" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="充电起" />
                            <TextBox x:Name="ChargeStartBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="充电止" />
                            <TextBox x:Name="ChargeEndBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="8" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="放电起" />
                            <TextBox x:Name="DischargeStartBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="18" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="放电止" />
                            <TextBox x:Name="DischargeEndBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="22" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource TextCaption}"
                            Text="段内时长按采样点梯形权重算：12 个点（3 小时）实际 2.875 h，不是 3 h"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Rectangle Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource TextCaption}" Text="充电口径（mode）" />
                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnParamChanged" />
                        <TextBlock
                            x:Name="ModeHint"
                            Style="{StaticResource TextCaption}"
                            Text=""
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource TextCaption}" Text="评估策略（basis）" />
                        <ComboBox x:Name="BasisCombo" HorizontalAlignment="Stretch" SelectionChanged="OnParamChanged" />
                        <TextBlock
                            x:Name="BasisHint"
                            Style="{StaticResource TextCaption}"
                            Text=""
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="容量线 kW（mode A 必填）" />
                            <TextBox x:Name="CapacityLineBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="800" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="额定功率 kW（B/C 必填）" />
                            <TextBox x:Name="RatedPowerBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="100" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="DOD %" />
                            <TextBox x:Name="DodBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" Text="95" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource TextCaption}" Text="目标天数（可空）" />
                            <TextBox x:Name="TargetDaysBox" FontFamily="{StaticResource MonoFamily}" LostFocus="OnParamChanged" PlaceholderText="留空=最严" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="IgnoreNegativeCheck" Checked="OnParamChanged" Content="忽略负荷负值（光伏返送）" IsChecked="True" Unchecked="OnParamChanged" />
                    <TextBlock
                        Style="{StaticResource TextCaption}"
                        Text="勾上会把负负荷清零 —— mode B/C 的充电空间因此归 0，实测充电为 0 时先查这里。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- 右：结果 -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Style="{StaticResource TextCaption}" Text="日需求（电池该装多大）" />
                        <TextBlock
                            x:Name="DemandText"
                            FontFamily="{StaticResource MonoFamily}"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="—" />
                        <TextBlock x:Name="DemandSubText" Style="{StaticResource TextCaption}" Text="kWh" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource TextCaption}" Text="日吞吐（一天能搬多少）" />
                        <TextBlock
                            x:Name="ThroughputText"
                            FontFamily="{StaticResource MonoFamily}"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="—" />
                        <TextBlock x:Name="ThroughputSubText" Style="{StaticResource TextCaption}" Text="kWh/天" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Style="{StaticResource TextCaption}" Text="建议装机容量" />
                        <TextBlock
                            x:Name="InstalledText"
                            FontFamily="{StaticResource MonoFamily}"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="—" />
                        <TextBlock x:Name="InstalledSubText" Style="{StaticResource TextCaption}" Text="kWh（含 DOD）" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource TextCaption}"
                    Text="两个量纲不可互换：日需求回答「装多大」，日吞吐回答「一天搬多少」。"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="2" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource TextCaption}" Text="分段明细" />
                    <ListView
                        x:Name="SegmentList"
                        Grid.Row="1"
                        MaxHeight="140"
                        Padding="0"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,4" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <TextBlock
                        x:Name="HintsText"
                        Grid.Row="2"
                        Style="{StaticResource TextCaption}"
                        Text=""
                        TextWrapping="Wrap" />

                    <StackPanel Grid.Row="3" Spacing="2" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource TextCaption}" Text="每日明细" />
                        <TextBlock
                            x:Name="DailySubText"
                            Style="{StaticResource TextCaption}"
                            Text="日期 · 充电空间 · 放电空间 · 最小段空间（月口径同：min 各段充+放）"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="4" Padding="4,4,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextCaption}" Text="日期" />
                        <TextBlock Grid.Column="1" HorizontalTextAlignment="Right" Style="{StaticResource TextCaption}" Text="充电" />
                        <TextBlock Grid.Column="2" HorizontalTextAlignment="Right" Style="{StaticResource TextCaption}" Text="放电" />
                        <TextBlock Grid.Column="3" HorizontalTextAlignment="Right" Style="{StaticResource TextCaption}" Text="最小段" />
                    </Grid>

                    <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="DailyGrid" Padding="4,0,4,4" />
                    </ScrollViewer>
                </Grid>

                <!-- 月度表：跨文件按月份聚合。同月份后者覆盖前者（Fusion 既有行为）。 -->
                <!-- 高度用 Auto + 内部 MaxHeight：固定高会把每日明细挤没（实跑已撞过）。 -->
                <Grid Grid.Row="3" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource TextCaption}" Text="月度表（跨文件按月份聚合）" />
                    <TextBlock
                        x:Name="MonthlySubText"
                        Grid.Row="1"
                        Style="{StaticResource TextCaption}"
                        Text="最小段空间 = 本月各段中最小的那一段（充+放）；「N 源」表示该月有多个文件，本行取后加载的那个"
                        TextWrapping="Wrap" />

                    <ScrollViewer
                        Grid.Row="2"
                        MaxHeight="180"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="MonthlyGrid" Padding="4,0,4,4" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="28,10,28,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MonoFamily}"
                FontSize="{StaticResource FsCaption}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text=""
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnBackClick" Content="返回导出" />
                <Button
                    x:Name="CalcButton"
                    Click="OnCalcClick"
                    Content="测算"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
