<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LoomGrid.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LoomGrid.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="32,20,32,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="LoomGrid Pro" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="启动自检 · Python 后端健康检查" />
        </StackPanel>

        <!-- 状态卡 -->
        <Border
            Grid.Row="1"
            Padding="20"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="14">
                <Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="Busy"
                            Width="20"
                            Height="20"
                            IsActive="True"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="正在启动 Python 后端…" />
                    </StackPanel>
                    <Button
                        x:Name="RetryButton"
                        HorizontalAlignment="Right"
                        Click="OnRetryClick"
                        Content="重试"
                        Visibility="Collapsed" />
                </Grid>

                <Grid ColumnSpacing="28" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="端口" />
                    <TextBlock
                        x:Name="PortText"
                        Grid.Row="0"
                        Grid.Column="1"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Text="—" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="进程" />
                    <TextBlock
                        x:Name="PidText"
                        Grid.Row="1"
                        Grid.Column="1"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Text="—" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="进程守护" />
                    <TextBlock
                        x:Name="JobText"
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="—"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="就绪耗时" />
                    <TextBlock
                        x:Name="ReadyText"
                        Grid.Row="3"
                        Grid.Column="1"
                        FontFamily="Consolas"
                        Text="—" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 详情卡：健康 JSON + 启动日志 -->
        <Border
            Grid.Row="2"
            Padding="20"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="GET /api/health" />

                <ScrollViewer
                    x:Name="DetailScroller"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock
                            x:Name="HealthText"
                            FontFamily="Consolas"
                            FontSize="12.5"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="LogText"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
