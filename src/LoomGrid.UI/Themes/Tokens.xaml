<?xml version="1.0" encoding="utf-8" ?>
<!--
    设计令牌：LoomGrid 的「内容层」规格。
    与 Fluent 的分工：
      · 这里定的是字号梯度、间距节奏、语义色、等宽数字、行高密度
      · 材质（Mica / Acrylic / 圆角 / 阴影）交给 Fluent，不在这里覆盖
    所有页面通过 StaticResource 引用，页面里不写裸字号与裸色值。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 属性元素必须写在所有内容项之前，否则 XamlCompiler 报 WMC0035 -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- 语义色：就绪绿 / 需确认黄 / 错误红 / 数据青 -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SemanticReadyBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="SemanticWarnBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="SemanticErrorBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="SemanticDataBrush" Color="#0969DA" />
            <SolidColorBrush x:Key="SemanticIdleBrush" Color="#6E7781" />
            <!-- 表格：表头底与单元格网格线 -->
            <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#F6F8FA" />
            <SolidColorBrush x:Key="TableCellBorderBrush" Color="#D0D7DE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SemanticReadyBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="SemanticWarnBrush" Color="#D29922" />
            <SolidColorBrush x:Key="SemanticErrorBrush" Color="#F85149" />
            <SolidColorBrush x:Key="SemanticDataBrush" Color="#4EA8DE" />
            <SolidColorBrush x:Key="SemanticIdleBrush" Color="#8B949E" />
            <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="TableCellBorderBrush" Color="#30363D" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ── 字阶：5 档 ─────────────────────────────────────
         原始设计稿是 104/42/30/16/12.5（落地页尺度），桌面端按同一比例缩。 -->
    <x:Double x:Key="FsDisplay">30</x:Double>
    <x:Double x:Key="FsTitle">21</x:Double>
    <x:Double x:Key="FsSubtitle">16</x:Double>
    <x:Double x:Key="FsBody">13</x:Double>
    <x:Double x:Key="FsCaption">11.5</x:Double>

    <!-- ── 间距：4 的倍数 ──────────────────────────────── -->
    <x:Double x:Key="SpXs">4</x:Double>
    <x:Double x:Key="SpS">8</x:Double>
    <x:Double x:Key="SpM">12</x:Double>
    <x:Double x:Key="SpL">16</x:Double>
    <x:Double x:Key="SpXl">24</x:Double>
    <x:Double x:Key="SpXxl">32</x:Double>

    <Thickness x:Key="PagePadding">28,18,28,14</Thickness>
    <Thickness x:Key="CardPadding">16,14,16,14</Thickness>

    <!-- ── 圆角 ────────────────────────────────────────── -->
    <CornerRadius x:Key="CardCorner">4</CornerRadius>
    <CornerRadius x:Key="DialogCorner">8</CornerRadius>

    <!-- ── 数字等宽 ────────────────────────────────────── -->
    <FontFamily x:Key="MonoFamily">Consolas</FontFamily>

    <!-- ── 数据行高：一屏 20 行密度 ─────────────────────── -->
    <x:Double x:Key="DataRowHeight">32</x:Double>

    <!-- ── 文本样式（把字阶包成可直接套的 Style） ───────── -->
    <Style x:Key="TextDisplay" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 数字：等宽 + 右对齐（表格里的数值列） -->
    <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFamily}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

</ResourceDictionary>
