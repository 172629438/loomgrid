# 备份文件：修复过程的中间产物，不入库
*.bak
*.bak-*
*.bak2
*.bak3
*.bak4
*.bak5

# 历史版本目录：含运行日志与配置备份（业务痕迹），不入库
旧版本程序/
config_backups/
column_mapping_config.json

# 运行日志
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/

# 运行时产物
*.log
logs/
output/
exports/
temp/
tmp/
~$*

# 数据文件（体积大且含业务数据，不入库）
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
*.db
*.sqlite

# 生成物
*.png
*.jpg
*.jpeg
*.svg
*.pdf
*.html
!README.md
!assets/*.png
!assets/*.ico
!assets/*.webp

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 构建产物
build/
dist/
*.spec
build_*.log
build_*.err.log
build_logs/

# 打包用源文件副本（由 tools/build_exe_cx.py 自动生成）
loomgrid_*_main.py

!assets/versions/*.png

# 前端源码与设计原型必须入库，不受上面 *.html 全局排除影响
# （那个 *.html 是为了挡生成的报告，不是挡源码）
!web/**/*.html

# 打包产物目录（本机 release 构建残留，不入库）
build_release/

# 落地页演示数据与截图（由 tools/demo_anim 生成，可重建，不入库）
assets/demo.png
tools/demo_anim/demo_data.js

# .NET / WinUI 3 构建产物（LoomGrid.sln）
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.pubxml
publish/

# WinUI 应用的图标资源必须入库（上面的 *.png 排除是挡生成图片的）
!src/LoomGrid.UI/Assets/*.png
!src/LoomGrid.UI/Assets/*.ico

# CurveSpike 能力回归验证器的产物
tools/CurveSpike/out/

